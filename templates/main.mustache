{{!
    @template block_vitrinadb/main

    This template renders the template content area for a resource.

    Example context (json):
    {
        "uniqueid": "unique_id_string"
    }
}}

<div id="{{uniqueid}}" class="block_vitrina-content {{#inline}}vitrina-layout-line{{/inline}}{{^inline}}vitrina-layout-tile{{/inline}}" data-layoutmode="{{layoutmode}}" data-observe-resizes>

    {{#inline}}
        <div class="block_vitrina-line-header">
    {{/inline}}
    {{>block_vitrinadb/tabs}}
    {{#inline}}
            <div class="vitrina-line-controls">
                <span class="vitrina-line-count" title="{{#str}}layoutmode_counttitle, block_vitrinadb{{/str}}">
                    <span class="vitrina-line-current">0</span>{{#str}}layoutmode_countsep, block_vitrinadb{{/str}}<span class="vitrina-line-total">0</span>
                </span>
                <button type="button" class="vitrina-line-arrow vitrina-line-prev" aria-label="{{#str}}layoutmode_prev, block_vitrinadb{{/str}}">
                    <i class="vitrina-line-arrow-icon icon fa fa-chevron-left fa-fw" aria-hidden="true"></i>
                </button>
                <button type="button" class="vitrina-line-arrow vitrina-line-next" aria-label="{{#str}}layoutmode_next, block_vitrinadb{{/str}}">
                    <i class="vitrina-line-arrow-icon icon fa fa-chevron-right fa-fw" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    {{/inline}}

    <div class="tabs-content block_vitrina-courseslist">
        {{#tabs}}
            <div class="courses tab-{{key}} block_vitrina-tabcontent {{state}} loading" data-view="{{key}}" {{#inline}}data-inline="1"{{/inline}}>

                <div class="courses-list"></div>
                <div class="nocourses alert alert-dismissible alert-warning hidden"></div>

                <a href="{{baseurl}}/blocks/vitrinadb/?view={{key}}&id={{instanceid}}{{#channel}}&channel={{channel}}{{/channel}}" target="{{opendetailstarget}}" class="btn btn-primary btn-block loadmore {{#inline}}hidden{{/inline}}">
                    {{#str}}viewall, block_vitrinadb{{/str}}
                </a>

            </div>
        {{/tabs}}
    </div>
</div>